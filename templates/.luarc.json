{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "Lua.completion.requireSeparator": "/",
  "runtime": {
    "version": "Lua 5.4",
    "pathStrict": true,
    "path": [
      "Server/?",
      "Server/?.lua",
      "Client/?",
      "Client/?.lua",
      "Shared/?",
      "Shared/?.lua",
      "?",
      "?.lua",
      "Packages/?",
      "Packages/?.lua"
    ],
    "special": {
      "Package.Require": "require"
    }
  },
  "workspace": {
    "checkThirdParty": false,
    "ignoreDir": [
      ".git",
      ".vscode",
      ".nanos-lint",
      "node_modules",
      "dist",
      "bin",
      "vendor",
      "script",
      "meta",
      "locale",
      "log"
    ],
    "library": []
  },
  "files": {
    "exclude": [".nanos-lint/**"]
  },
  "diagnostics": {
    "enable": true,
    "neededFileStatus": {
      "unused-local": "Any",
      "redefined-local": "Any"
    },
    "disable": ["different-requires"],
    "severity": {
      "redefined-local": "Warning",
      "unused-local": "Warning",
      "unused-vararg": "Warning"
    }
  },
  "nanos": {
    "realms": {
      "Server/**": "server",
      "Client/**": "client",
      "Shared/**": "shared"
    }
  }
}
